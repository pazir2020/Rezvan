# Copy to .env (scripts/run.* does it for you) and keep this file private.
# PostgreSQL superuser, used ONLY by `init-db` to create the schema and the application role.
HR_ADMIN_DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@localhost:5432/hr_rezvan
# The application connects as a limited role (cannot update/delete audit rows).
HR_DATABASE_URL=postgresql://hr_app:CHANGE_ME_APP_PASSWORD@localhost:5432/hr_rezvan
HR_SECRET_KEY=CHANGE_ME_SECRET_KEY
HR_COOKIE_SECURE=0
HR_SESSION_IDLE_SECONDS=1800
HR_SESSION_ABSOLUTE_SECONDS=43200
HR_MAX_UPLOAD_MB=25
HR_MIN_PASSWORD_LENGTH=6
# HR_DOC_ROOT=..\data\documents
# HR_BACKUP_DIR=..\data\backups
# HR_FIELD_OVERRIDES=field_overrides.json   {"collection": ["extraField", ...]} approved after reviewing migration reports
